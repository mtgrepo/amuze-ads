DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=advertiser-system
# Set to "true" if the Postgres server requires TLS (common on managed DB providers)
DB_SSL=false

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1d

MINIO_ENDPOINT=
MINIO_PORT=
MINIO_REGION=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# Placeholder auth for the ad-serving endpoint — replace once the main Amuze
# backend team decides the real service-to-service auth mechanism (spec §4.7)
AD_SERVING_API_KEY=

# Comma-separated list of allowed CORS origins for this environment
# (e.g. https://uat-portal.ad.amuze.com.mm,https://uat-customer.ad.amuze.com.mm).
# Falls back to a hardcoded dev/UAT list in src/main.ts if unset.
CORS_ORIGINS=

# Email for password reset links. Without SMTP_HOST, development logs the email instead of sending it;
# production refuses to send reset links until it's set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Amuze Ads <no-reply@example.com>"
# Where reset links point (the customer portal's address, no trailing slash).
CUSTOMER_PORTAL_URL=http://localhost:5174
