DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=advertiser-system
# Set to "true" if the Postgres server requires TLS (common on managed DB providers)
DB_SSL=false

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1d

MINIO_ENDPOINT=
MINIO_PORT=
MINIO_REGION=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# Placeholder auth for the ad-serving endpoint — replace once the main Amuze
# backend team decides the real service-to-service auth mechanism (spec §4.7)
AD_SERVING_API_KEY=

# Comma-separated list of allowed CORS origins for this environment
# (e.g. https://uat-portal.ad.amuze.com.mm,https://uat-customer.ad.amuze.com.mm).
# Falls back to a hardcoded dev/UAT list in src/main.ts if unset.
CORS_ORIGINS=
